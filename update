#!/bin/bash

# Run all package configuration non-interactively. hoobsd invokes this script with no controlling
# tty, so any debconf prompt (e.g. iperf3 "start Iperf3 as a daemon?") would block the update
# forever. Non-interactive mode auto-answers with defaults so the update can never hang.
export DEBIAN_FRONTEND=noninteractive

# --- Kernel/BSP freeze (ALL channels) ----------------------------------------------------------
# A blanket `apt-get upgrade` would swap the board's tested kernel for whatever Armbian ships in its
# rolling "current" branch (e.g. 6.12 -> 6.18), dropping the board device-tree / WiFi / ethernet
# customisations that only exist on the pinned 6.12/6.13 kernel (the M4 Berry lost WiFi + gigabit
# exactly this way). Freeze the kernel + board-support packages so an upgrade can never move them.
# Applies to EVERY channel: the fielded fleet runs stable/edge, and repairing apt (below) un-blocks
# the kernel drag on exactly those boxes, so the hold is essential on stable — not just bleeding.
# Fully reversible with `apt-mark unhold` when a tested kernel is shipped deliberately.
for pkg in $(dpkg-query -W -f='${Package}\n' 2>/dev/null | grep -E '^(linux-image|linux-dtb|linux-headers|linux-u-boot|armbian-bsp)'); do
    apt-mark hold "$pkg" >/dev/null 2>&1 || true
done

function ensure_if_exists {
filename="$1"
url="$2"
sha="$3"
test -f $filename || return
chmod 644 "$filename"
echo "$sha $filename" | sha256sum --check && return
tmpfile=$(mktemp)
curl -ks "$url" | gpg --dearmor > "$tmpfile"
if (echo  "$sha $tmpfile" | sha256sum --check)
then
  mv "$tmpfile" "$filename"
  chmod 644 "$filename"
else
  echo "$url has wrong sha256. $sha vs $(sha256sum $tmpfile)"
fi
rm -f "$tmpfile"
}

ensure_if_exists /usr/share/keyrings/hoobs.gpg https://dl.hoobs.org/debian/pubkey.gpg.key f1ff8b2b652022f4e7a22621db9b748ca3fb02d83ac03f4ec18e69b1c4c7d746

# Refresh the NodeSource + Yarn signing keys as proper BINARY keyrings. Boxes may carry OLD keys
# (NodeSource's from 2014, Yarn's from 2016) that the CURRENT repos are no longer signed with
# (NO_PUBKEY), and the sha-gated ensure_if_exists can't refresh a rotated key. Two-step
# (download-to-file then `gpg --dearmor --yes -o`) reliably overwrites non-interactively — a piped
# `gpg --dearmor -o` onto an existing file would PROMPT and hang a tty-less update.
_ns=$(mktemp)
if curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o "$_ns" 2>/dev/null && [ -s "$_ns" ]; then
    gpg --dearmor --yes -o /usr/share/keyrings/nodesource.gpg "$_ns" 2>/dev/null && chmod 644 /usr/share/keyrings/nodesource.gpg
fi
rm -f "$_ns"

_yn=$(mktemp)
if curl -fsSL https://dl.yarnpkg.com/debian/pubkey.gpg -o "$_yn" 2>/dev/null && [ -s "$_yn" ]; then
    gpg --dearmor --yes -o /usr/share/keyrings/yarnkey.gpg "$_yn" 2>/dev/null && chmod 644 /usr/share/keyrings/yarnkey.gpg
fi
rm -f "$_yn"

# Persistently switch this box to a non-interactive debconf frontend. A HOOBS box is headless, so
# any package that asks a debconf question would hang a tty-less update. Writing this to the
# debconf database means EVERY future apt run — including one driven by OLDER hoobsd that never
# exported DEBIAN_FRONTEND — uses defaults and never prompts. This is what protects already-deployed
# boxes before they upgrade. Validated to stop the iperf3 hang on Debian 12 (bookworm).
echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections 2>/dev/null || true
dpkg-reconfigure -f noninteractive debconf > /dev/null 2>&1 || true


if [ -f /etc/apt/sources.list.d/nodesource.list ]; then
    # Node 22 on ALL channels. NodeSource retired the per-Debian-codename suites (bullseye AND
    # bookworm now 404) and serves every distro from the unified 'nodistro' suite, so write the
    # line deterministically. Node 22 is the current LTS and is published for BOTH arm64 and armhf
    # on nodistro (armhf is the ceiling — Node 24 has no 32-bit ARM build); Node 20 is EOL.
    echo 'deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main' > /etc/apt/sources.list.d/nodesource.list
fi

# Disable the retired bullseye-backports suite. Debian removed bullseye-backports; its Release file
# now 404s, which makes `apt-get update` exit non-zero on bullseye boxes (HSLF-1/HSLF-2) — breaking
# every hoobsd path that shells `apt-get update` (hbs system reset, System.info, the update check).
# Nothing on the fleet is installed from backports (verified: no ~bpo11 packages), so commenting the
# source out is lossless. Self-guarding: only lines that contain 'bullseye-backports' are touched,
# so bookworm boxes (HSLF-3 — no such line) are completely unaffected, and lines already commented
# (starting with #) don't match, so re-running is idempotent.
for _src in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do
    [ -f "$_src" ] || continue
    sed -i -E 's|^([[:space:]]*deb(-src)?[[:space:]].*bullseye-backports)|# \1|' "$_src"
done

apt-get update --allow-releaseinfo-change
dpkg --configure -a --force-confnew
